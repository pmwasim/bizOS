{
  "name": "@bizo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./customers": {
      "types": "./dist/customers.d.ts",
      "default": "./dist/customers.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    },
    "./quotations": {
      "types": "./dist/quotations.d.ts",
      "default": "./dist/quotations.js"
    },
    "./purchase-orders": {
      "types": "./dist/purchase-orders.d.ts",
      "default": "./dist/purchase-orders.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

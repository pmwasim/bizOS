{
  "name": "@bizo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./jobs": {
      "types": "./dist/jobs.d.ts",
      "default": "./dist/jobs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",

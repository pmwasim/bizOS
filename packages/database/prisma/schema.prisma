// A refund is money returned to the customer against a COMPLETED payment. It is a distinct,
// append-only negative movement — the original payment's amount is never mutated — so the net
// customer/invoice position is derived (payment amount less the sum of its refunds), exactly like
// settlement is derived from allocations. `amountMinor` is the positive magnitude returned; the
// cumulative refunded amount is fail-closed to never exceed the payment amount. See
// docs/decisions/0025-payment-void-reversal-refund.md.
model PaymentRefund {
  id                    BigInt   @id @default(autoincrement())
  publicId              String   @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId              BigInt   @map("tenant_id")
  businessId            BigInt   @map("business_id")
  paymentId             BigInt   @map("payment_id")
  amountMinor           Decimal  @map("amount_minor") @db.Decimal(38, 0)
  currencyCode          String   @map("currency_code") @db.Char(3)
  currencyScale         Int      @map("currency_scale") @db.SmallInt
  reason                String?  @db.VarChar(500)
  createdByMembershipId BigInt   @map("created_by_membership_id")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business   @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)
  payment  Payment    @relation(fields: [tenantId, businessId, paymentId], references: [tenantId, businessId, id], onDelete: Cascade)
  creator  Membership @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, paymentId])
  @@map("payment_refunds")
}


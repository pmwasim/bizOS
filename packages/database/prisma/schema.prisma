generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum RoleCode {
  OWNER
  ADMIN
  MEMBER
  STAFF
  ACCOUNTANT
  EXTERNAL_AUDITOR
}

enum DocumentType {
  QUOTATION
  INVOICE
  SALES_ORDER
  DELIVERY_NOTE
  SERVICE_COMPLETION
  SUPPLIER_QUOTATION
  SUPPLIER_PURCHASE_ORDER
  SUPPLIER_BILL
  GOODS_RECEIPT_NOTE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum PaymentType {
  INBOUND
  OUTBOUND
}

enum PaymentStatus {
  DRAFT
  COMPLETED
  REVERSED
  VOIDED
}

enum DocumentStatus {
  DRAFT
  READY_TO_SEND
  SENT
  SEND_FAILED
  ARCHIVED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum PurchaseOrderStatus {
  ACTIVE
  ARCHIVED
}

enum InvoiceApprovalStatus {
  NOT_RECORDED
  PENDING
  APPROVED
  REJECTED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  FAILED
  DEAD
}

enum StoredObjectKind {
  PURCHASE_ORDER
  APPROVAL_EVIDENCE
  SUPPLIER_PO
  SUPPLIER_BILL
  GOODS_RECEIPT
  PROJECT_EVIDENCE
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum ConfigurationTemplateKind {
  DEFAULT
  SPECIALIZED
  INDUSTRY
}

enum ConfigurationVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
  MULTILINE
}

enum IndustryPackStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ConfigurationAuditAction {
  CREATE
  UPDATE
  PUBLISH
  RETIRE
  ASSIGN
  UNASSIGN
}

enum CustomizationRequestUrgency {
  LOW
  MEDIUM
  HIGH
}

enum CustomizationRequestStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum PlatformSystemAdminStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           BigInt   @id @default(autoincrement())
  publicId     String   @unique @default(uuid()) @map("public_id") @db.Uuid
  email        String   @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(120)
  locale       String   @default("en") @db.VarChar(35)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships           Membership[]
  auditEvents           AuditEvent[]
  approvalChanges       PurchaseOrder[]      @relation("PurchaseOrderApprovalActor")
  uploadedStoredObjects StoredObject[]       @relation("StoredObjectUploader")
  systemAdmin           PlatformSystemAdmin?
  passwordResetTokens   PasswordResetToken[]

  @@index([publicId])
  @@map("users")
}

/// Single-use password reset grants. Only the SHA-256 hash of the emailed token is stored, so a
/// database read cannot be turned into an account takeover. Rows are retained after use so a
/// consumed link fails closed rather than looking like an unknown token.
model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Tenant {
  id        BigInt   @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @map("public_id") @db.Uuid
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  businesses               Business[]
  memberships              Membership[]
  roles                    Role[]
  configurationAuditEvents ConfigurationAuditEvent[]
  customizationRequests    CustomizationRequest[]

  @@map("tenants")
}

model Membership {
  id        BigInt           @id @default(autoincrement())
  publicId  String           @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId  BigInt           @map("tenant_id")
  userId    BigInt           @map("user_id")
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                   Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                     User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessAccess           BusinessAccess[]
  documents                Document[]
  createdPayments          Payment[]
  createdPaymentRefunds    PaymentRefund[]
  purchaseOrders           PurchaseOrder[]
  auditEvents              ConfigurationAuditEvent[]
  configurationAssignments BusinessConfigurationAssignment[]
  customizationRequests    CustomizationRequest[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId, status])
  @@map("memberships")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  publicId    String   @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId    BigInt   @map("tenant_id")
  code        RoleCode
  name        String   @db.VarChar(80)
  permissions String[] @default([]) @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  businessAccess BusinessAccess[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("roles")
}

model Business {
  id            BigInt   @id @default(autoincrement())
  publicId      String   @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId      BigInt   @map("tenant_id")
  name          String   @db.VarChar(160)
  legalName     String?  @map("legal_name") @db.VarChar(200)
  countryCode   String   @map("country_code") @db.Char(2)
  baseCurrency  String   @map("base_currency") @db.Char(3)
  currencyScale Int      @default(2) @map("currency_scale") @db.SmallInt
  locale        String   @default("en") @db.VarChar(35)
  timeZone      String   @default("UTC") @map("time_zone") @db.VarChar(64)
  email         String?  @db.VarChar(320)
  phone         String?  @db.VarChar(40)
  addressLine1  String?  @map("address_line_1") @db.VarChar(200)
  addressLine2  String?  @map("address_line_2") @db.VarChar(200)
  city          String?  @db.VarChar(120)
  postalCode    String?  @map("postal_code") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant                   Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  access                   BusinessAccess[]
  settings                 BusinessSettings?
  taxProfile               TaxProfile?
  customers                Customer[]
  documents                Document[]
  payments                 Payment[]
  paymentAllocations       PaymentAllocation[]
  paymentRefunds           PaymentRefund[]
  purchaseOrders           PurchaseOrder[]
  storedObjects            StoredObject[]
  auditEvents              AuditEvent[]
  outboxEvents             OutboxEvent[]
  assignments              BusinessConfigurationAssignment[]
  documentWorkflowContexts DocumentWorkflowContext[]
  customFieldDefinitions   CustomFieldDefinition[]
  featureFlags             FeatureFlag[]
  customizationRequests    CustomizationRequest[]
  apiKeys                  ApiKey[]
  products                 Product[]
  webhookEndpoints         WebhookEndpoint[]
  suppliers                Supplier[]
  leads                    Lead[]
  opportunities            Opportunity[]
  projects                 Project[]
  inventoryItems           InventoryItem[]
  creditNoteAllocations    CreditNoteAllocation[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@map("businesses")
}

model BusinessAccess {
  tenantId     BigInt   @map("tenant_id")
  businessId   BigInt   @map("business_id")
  membershipId BigInt   @map("membership_id")
  roleId       BigInt   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business   Business   @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, businessId, membershipId])
  @@index([tenantId, membershipId])
  @@index([tenantId, roleId])
  @@map("business_access")
}

model BusinessSettings {
  businessId            BigInt @id @map("business_id")
  tenantId              BigInt @map("tenant_id")
  quotationPrefix       String @default("Q") @map("quotation_prefix") @db.VarChar(12)
  nextQuotationNumber   Int    @default(1) @map("next_quotation_number")
  quotationValidityDays Int    @default(30) @map("quotation_validity_days") @db.SmallInt
  invoicePrefix         String @default("INV") @map("invoice_prefix") @db.VarChar(12)
  nextInvoiceNumber     Int    @default(1) @map("next_invoice_number")
  invoiceDueDays        Int    @default(30) @map("invoice_due_days") @db.SmallInt
  paymentPrefix         String @default("PAY") @map("payment_prefix") @db.VarChar(12)
  nextPaymentNumber     Int    @default(1) @map("next_payment_number")

  salesOrderPrefix        String @default("SO") @map("sales_order_prefix") @db.VarChar(12)
  nextSalesOrderNumber    Int    @default(1) @map("next_sales_order_number")
  deliveryNotePrefix      String @default("DN") @map("delivery_note_prefix") @db.VarChar(12)
  nextDeliveryNoteNumber  Int    @default(1) @map("next_delivery_note_number")
  creditNotePrefix        String @default("CN") @map("credit_note_prefix") @db.VarChar(12)
  nextCreditNoteNumber    Int    @default(1) @map("next_credit_note_number")
  purchaseOrderPrefix     String @default("PO") @map("purchase_order_prefix") @db.VarChar(12)
  nextPurchaseOrderNumber Int    @default(1) @map("next_purchase_order_number")
  supplierPoPrefix        String @default("SPO") @map("supplier_po_prefix") @db.VarChar(12)
  nextSupplierPoNumber    Int    @default(1) @map("next_supplier_po_number")
  supplierBillPrefix      String @default("BILL") @map("supplier_bill_prefix") @db.VarChar(12)
  nextSupplierBillNumber  Int    @default(1) @map("next_supplier_bill_number")

  // Zero-padding width applied to the sequence part of every document number, e.g. width 4
  // renders `INV-0001`. Configurable per business; allocation stays gap-safe and race-safe
  // regardless of the width.
  numberPadWidth Int @default(4) @map("number_pad_width") @db.SmallInt

  defaultMessage String?  @map("default_message") @db.VarChar(1000)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, businessId])
  @@map("business_settings")
}

model TaxProfile {
  businessId         BigInt   @id @map("business_id")
  tenantId           BigInt   @map("tenant_id")
  enabled            Boolean  @default(false)
  name               String   @default("Tax") @db.VarChar(80)
  registrationNumber String?  @map("registration_number") @db.VarChar(80)
  ratePpm            Int      @default(0) @map("rate_ppm")
  priceIncludesTax   Boolean  @default(false) @map("price_includes_tax")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, businessId])
  @@map("tax_profiles")
}

model Customer {
  id           BigInt   @id @default(autoincrement())
  publicId     String   @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId     BigInt   @map("tenant_id")
  businessId   BigInt   @map("business_id")
  name         String   @db.VarChar(200)
  email        String?  @db.VarChar(320)
  phone        String?  @db.VarChar(40)
  addressLine1 String?  @map("address_line_1") @db.VarChar(200)
  addressLine2 String?  @map("address_line_2") @db.VarChar(200)
  city         String?  @db.VarChar(120)
  postalCode   String?  @map("postal_code") @db.VarChar(32)
  countryCode  String?  @map("country_code") @db.Char(2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)
  documents      Document[]
  purchaseOrders PurchaseOrder[]
  projects       Project[]

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, name])
  @@map("customers")
}

model Document {
  id                    BigInt         @id @default(autoincrement())
  publicId              String         @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId              BigInt         @map("tenant_id")
  businessId            BigInt         @map("business_id")
  // Nullable since 20260807031700: supplier-facing types (SUPPLIER_QUOTATION,
  // SUPPLIER_PURCHASE_ORDER, SUPPLIER_BILL, GOODS_RECEIPT_NOTE) have a supplier on the other side
  // of the transaction, not a customer.
  customerId            BigInt?        @map("customer_id")
  supplierId            BigInt?        @map("supplier_id")
  type                  DocumentType
  status                DocumentStatus @default(DRAFT)
  number                String         @db.VarChar(40)
  issueDate             DateTime       @map("issue_date") @db.Date
  validUntil            DateTime       @map("valid_until") @db.Date
  dueDate               DateTime?      @map("due_date") @db.Date
  deliveryDate          DateTime?      @map("delivery_date") @db.Date
  receivedAt            DateTime?      @map("received_at") @db.Timestamptz(3)
  sourceQuotationId     BigInt?        @map("source_quotation_id")
  sourceDocumentId      BigInt?        @map("source_document_id")
  referenceDocumentId   BigInt?        @map("reference_document_id")
  purchaseOrderId       BigInt?        @map("purchase_order_id")
  projectReference      String?        @map("project_reference") @db.VarChar(120)
  poNumberSnapshot      String?        @map("po_number_snapshot") @db.VarChar(80)
  notes                 String?        @db.VarChar(2000)
  currencyCode          String         @map("currency_code") @db.Char(3)
  currencyScale         Int            @map("currency_scale") @db.SmallInt
  subtotalMinor         Decimal        @map("subtotal_minor") @db.Decimal(38, 0)
  taxMinor              Decimal        @map("tax_minor") @db.Decimal(38, 0)
  totalMinor            Decimal        @map("total_minor") @db.Decimal(38, 0)
  version               Int            @default(1)
  sentAt                DateTime?      @map("sent_at") @db.Timestamptz(3)
  archivedAt            DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdByMembershipId BigInt         @map("created_by_membership_id")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business                          Business                 @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)
  customer                          Customer?                @relation(fields: [tenantId, businessId, customerId], references: [tenantId, businessId, id], onDelete: Restrict)
  supplier                          Supplier?                @relation(fields: [tenantId, businessId, supplierId], references: [tenantId, businessId, id], onDelete: Restrict)
  sourceQuotation                   Document?                @relation("DocumentSourceQuotation", fields: [tenantId, businessId, sourceQuotationId], references: [tenantId, businessId, id], onDelete: Restrict)
  derivedInvoices                   Document[]               @relation("DocumentSourceQuotation")
  sourceDocument                    Document?                @relation("DocumentSourceDocument", fields: [tenantId, businessId, sourceDocumentId], references: [tenantId, businessId, id], onDelete: Restrict)
  derivedDocuments                  Document[]               @relation("DocumentSourceDocument")
  referenceDocument                 Document?                @relation("DocumentReferenceDocument", fields: [tenantId, businessId, referenceDocumentId], references: [tenantId, businessId, id], onDelete: Restrict)
  referencingDocuments              Document[]               @relation("DocumentReferenceDocument")
  linkedPurchaseOrder               PurchaseOrder?           @relation("DocumentLinkedPurchaseOrder", fields: [tenantId, businessId, purchaseOrderId], references: [tenantId, businessId, id], onDelete: Restrict)
  lines                             DocumentLine[]
  versions                          DocumentVersion[]
  creator                           Membership               @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  paymentAllocations                PaymentAllocation[]
  purchaseOrders                    PurchaseOrder[]          @relation("PurchaseOrderQuotation")
  opportunities                     Opportunity[]            @relation("OpportunityQuotation")
  creditNoteAllocationsAsCreditNote CreditNoteAllocation[]   @relation("CreditNoteAllocationCreditNote")
  creditNoteAllocationsAsInvoice    CreditNoteAllocation[]   @relation("CreditNoteAllocationInvoice")
  workflowContext                   DocumentWorkflowContext?

  @@unique([tenantId, businessId, id])
  @@unique([tenantId, businessId, type, number])
  @@index([tenantId, businessId, type, status, createdAt])
  @@index([tenantId, businessId, sourceQuotationId])
  @@index([tenantId, businessId, sourceDocumentId])
  @@index([tenantId, businessId, referenceDocumentId])
  @@index([tenantId, businessId, supplierId])
  @@index([tenantId, businessId, purchaseOrderId])
  @@map("documents")
}

/// Allocation of a Payment against an invoice document or a purchase order.
///
/// This model previously described a second, never-deployed payment design: it declared
/// `invoice_document_id` and related to a `CustomerPayment` model whose `customer_payments` table
/// does not exist in the database. The live `payment_allocations` table, created by
/// 20260806152655_add_payment_module, has `document_id` and `purchase_order_id` and its
/// `payment_id` references `payments`. The definition below matches the deployed table.
// Phase 1 sales, procurement, CRM, and inventory entities. These tables are created by
// 20260807000000_phase1_sales_procurement_crm and are queried by the services in
// apps/api/src/{suppliers,crm,projects,inventory,credit-notes}, but were never declared here, so
// the generated client had no accessors for them and every one of those queries failed at runtime.

model Supplier {
  id           BigInt   @id @default(autoincrement())
  publicId     String   @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId     BigInt   @map("tenant_id")
  businessId   BigInt   @map("business_id")
  name         String   @db.VarChar(200)
  contactName  String?  @map("contact_name") @db.VarChar(120)
  email        String?  @db.VarChar(320)
  phone        String?  @db.VarChar(40)
  addressLine1 String?  @map("address_line_1") @db.VarChar(200)
  addressLine2 String?  @map("address_line_2") @db.VarChar(200)
  city         String?  @db.VarChar(120)
  postalCode   String?  @map("postal_code") @db.VarChar(32)
  countryCode  String?  @map("country_code") @db.Char(2)
  taxId        String?  @map("tax_id") @db.VarChar(80)
  taxName      String?  @map("tax_name") @db.VarChar(80)
  bankName     String?  @map("bank_name") @db.VarChar(120)
  iban         String?  @db.VarChar(34)
  swiftCode    String?  @map("swift_code") @db.VarChar(11)
  paymentTerms Int?     @map("payment_terms") @db.SmallInt
  notes        String?  @db.VarChar(2000)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business       Business        @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)
  documents      Document[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, name])
  @@index([tenantId, businessId, taxId])
  @@map("suppliers")
}

model Lead {
  id                     BigInt    @id @default(autoincrement())
  publicId               String    @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId               BigInt    @map("tenant_id")
  businessId             BigInt    @map("business_id")
  name                   String    @db.VarChar(200)
  company                String?   @db.VarChar(200)
  email                  String?   @db.VarChar(320)
  phone                  String?   @db.VarChar(40)
  source                 String?   @db.VarChar(80)
  status                 String    @default("NEW") @db.VarChar(40)
  estimatedValue         Decimal?  @map("estimated_value") @db.Decimal(38, 0)
  currencyCode           String?   @map("currency_code") @db.Char(3)
  notes                  String?   @db.VarChar(2000)
  assignedToMembershipId BigInt?   @map("assigned_to_membership_id")
  convertedAt            DateTime? @map("converted_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business      Business      @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)
  opportunities Opportunity[]

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, status])
  @@map("leads")
}

model Opportunity {
  id                     BigInt    @id @default(autoincrement())
  publicId               String    @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId               BigInt    @map("tenant_id")
  businessId             BigInt    @map("business_id")
  leadId                 BigInt?   @map("lead_id")
  quotationId            BigInt?   @map("quotation_id")
  name                   String    @db.VarChar(200)
  stage                  String    @default("PROSPECTING") @db.VarChar(40)
  probability            Int?      @db.SmallInt
  amountMinor            Decimal?  @map("amount_minor") @db.Decimal(38, 0)
  currencyCode           String?   @map("currency_code") @db.Char(3)
  expectedCloseDate      DateTime? @map("expected_close_date") @db.Date
  actualCloseDate        DateTime? @map("actual_close_date") @db.Date
  notes                  String?   @db.VarChar(2000)
  assignedToMembershipId BigInt?   @map("assigned_to_membership_id")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business  @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Restrict)
  lead      Lead?     @relation(fields: [tenantId, businessId, leadId], references: [tenantId, businessId, id], onDelete: SetNull)
  quotation Document? @relation("OpportunityQuotation", fields: [tenantId, businessId, quotationId], references: [tenantId, businessId, id], onDelete: SetNull)

  @@unique([tenantId, businessId, id])
  @@index([tenantId, businessId, stage])
  @@map("opportunities")
}

model Project {
  id           BigInt    @id @default(autoincrement())
  publicId     String    @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId     BigInt    @map("tenant_id")
  businessId   BigInt    @map("business_id")
  name         String    @db.VarChar(200)
  description  String?   @db.VarChar(2000)
  status       String    @default("ACTIVE") @db.VarChar(40)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  budgetMinor  Decimal?  @map("budget_minor") @db.Decimal(38, 0)

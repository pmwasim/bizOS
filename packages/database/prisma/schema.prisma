model ApiKey {
  id         BigInt       @id @default(autoincrement())
  publicId   String       @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId   BigInt       @map("tenant_id")
  businessId BigInt       @map("business_id")
  name       String       @db.VarChar(120)
  // Short, non-secret public identifier (the leading characters of the issued key). Shown in the
  // UI so a key can be recognised, and used as the lookup index during authentication before the
  // constant-time hash comparison.
  prefix     String       @map("prefix") @db.VarChar(24)
  secretHash String       @map("secret_hash") @db.VarChar(255)
  scopes     String[]     @default([]) @db.VarChar(80)
  status     ApiKeyStatus @default(ACTIVE)
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, businessId, id])
  @@index([publicId])
  @@index([prefix])
  @@map("api_keys")
}

/// An outbound webhook endpoint. The per-endpoint signing secret is stored ENCRYPTED (not hashed):
/// unlike an API key it must be recoverable at dispatch time to compute the HMAC over each payload.
model WebhookEndpoint {
  id              BigInt                @id @default(autoincrement())
  publicId        String                @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId        BigInt                @map("tenant_id")
  businessId      BigInt                @map("business_id")
  url             String                @db.VarChar(512)
  events          String[]              @default([]) @db.VarChar(120)
  // AES-256-GCM ciphertext of the `whsec_…` signing secret (never the plaintext). Column name is
  // retained from the prior schema for a data-safe migration.
  encryptedSecret String                @map("secret_hash") @db.VarChar(255)
  status          WebhookEndpointStatus @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  business   Business          @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([tenantId, businessId, id])
  @@index([publicId])
  @@index([tenantId, businessId, status])
  @@map("webhook_subscriptions")
}

/// One durable delivery attempt row — the webhook retry queue. Its worker fields mirror the
/// transactional OutboxEvent (attemptCount↔attempts, nextAttemptAt↔availableAt, DELIVERED↔published).
model WebhookDelivery {
  id                 BigInt                @id @default(autoincrement())
  publicId           String                @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId           BigInt                @map("tenant_id")
  // FK column name retained for a data-safe migration; models the owning endpoint.
  endpointId         BigInt                @map("webhook_subscription_id")
  eventType          String                @map("event_type") @db.VarChar(120)
  payload            Json
  status             WebhookDeliveryStatus @default(PENDING)
  attemptCount       Int                   @default(0) @map("attempt_count")
  nextAttemptAt      DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  responseStatusCode Int?                  @map("status_code")
  lastError          String?               @map("error_message") @db.VarChar(500)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model Product {
  id                BigInt   @id @default(autoincrement())
  publicId          String   @unique @default(uuid()) @map("public_id") @db.Uuid
  tenantId          BigInt   @map("tenant_id")

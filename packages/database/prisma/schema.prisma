  type              String   @default("PRODUCT") @map("type") @db.VarChar(20)
  unit              String?  @map("unit") @db.VarChar(20)
  costPriceMinor    Decimal? @map("cost_price_minor") @db.Decimal(38, 0)
  sellingPriceMinor Decimal? @map("selling_price_minor") @db.Decimal(38, 0)
  taxRatePpm        Int      @default(0) @map("tax_rate_ppm")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, businessId, id])
  @@unique([tenantId, businessId, sku])
  @@index([tenantId, businessId, name])
  @@map("products")
}

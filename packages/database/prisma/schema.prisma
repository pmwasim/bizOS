  business                     Business                     @relation(fields: [tenantId, businessId], references: [tenantId, id], onDelete: Cascade)
  configurationTemplateVersion ConfigurationTemplateVersion @relation(fields: [configurationTemplateVersionId], references: [id], onDelete: Restrict)
  assignedByMembership         Membership?                  @relation(fields: [assignedByMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, businessId])
  @@index([configurationTemplateVersionId])
  @@index([assignedByMembershipId])
  @@map("business_configuration_assignments")
}


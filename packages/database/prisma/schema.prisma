  code                    String             @unique @db.VarChar(40)
  name                    String             @db.VarChar(120)
  description             String?            @db.VarChar(500)
  configurationTemplateId BigInt?            @map("configuration_template_id")
  version                 String             @db.VarChar(20)
  status                  IndustryPackStatus @default(DRAFT)
  packJson                Json               @map("pack_json")
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  configurationTemplate ConfigurationTemplate? @relation(fields: [configurationTemplateId], references: [id], onDelete: Restrict)

  @@map("industry_packs")
}


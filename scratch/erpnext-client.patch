+      new URL(`/api/resource/${encodeURIComponent(docType)}/${encodeURIComponent(name)}`, connection.baseUrl),
+      {
+        headers: {
+          Accept: "application/json",
+          Authorization: `token ${connection.apiKey}:${connection.apiSecret}`,
+        },
+        method: "GET",
+      },
+    );
+
+    if (!response.ok) {
+      throw new ErpnextRequestError(response.status);
+    }
+
+    const body: unknown = await response.json();
+    return (body as { data: any }).data;
+  }

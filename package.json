{
  "name": "bizo",
  "version": "0.0.0",
  "private": true,
  "description": "A simple, workflow-first business operating system.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13 <25",
    "pnpm": ">=11.17 <12"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm docs:check && pnpm security:local-services && pnpm lint && pnpm typecheck && pnpm test && pnpm db:validate && pnpm build",
    "clean": "turbo run clean && rm -rf .turbo coverage",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "db:format": "pnpm --filter @bizo/database prisma:format",
    "db:validate": "pnpm --filter @bizo/database prisma:validate",
    "dev": "turbo run dev --parallel",
    "docs:check": "node scripts/check-doc-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "lefthook install",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:local-services": "node --test scripts/check-local-services.spec.mjs && node scripts/check-local-services.mjs",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}

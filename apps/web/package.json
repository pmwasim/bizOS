{
  "name": "@bizo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build && node ../../scripts/prepare-next-standalone.mjs",
    "clean": "rm -rf .next coverage tsconfig.tsbuildinfo",
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "lint": "eslint .",
    "start": "PORT=${WEB_PORT:-3000} HOSTNAME=0.0.0.0 node .next/standalone/apps/web/server.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bizo/config": "workspace:*",
    "@bizo/contracts": "workspace:*",
    "@bizo/ui": "workspace:*",
    "jose": "6.2.8",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.test"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "API_INTERNAL_URL",
        "API_PORT",
        "AUTH_SECRET",
        "AUTH_URL",
        "DATABASE_URL",
        "FRAPPE_API_KEY",
        "FRAPPE_API_SECRET",
        "FRAPPE_BASE_URL",
        "INTERNAL_AUTH_SECRET",
        "N8N_CI_WEBHOOK_URL",
        "N8N_CUSTOMIZATION_WEBHOOK_URL",
        "N8N_WEBHOOK_SECRET",
        "NEXT_PUBLIC_REVENUECAT_WEB_API_KEY",
        "R2_ACCESS_KEY_ID",
        "R2_ACCOUNT_ID",
        "R2_BUCKET",
        "R2_ENDPOINT",
        "R2_SECRET_ACCESS_KEY",
        "REDIS_PASSWORD",
        "REDIS_URL",
        "REVENUECAT_API_KEY",
        "SMTP_FROM",
        "SMTP_URL",
        "WEB_PORT"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "DATABASE_URL",
        "INTERNAL_AUTH_SECRET",
        "REDIS_URL",
        "REVENUECAT_API_KEY",
        "RUN_DATABASE_TESTS",
        "RUN_REDIS_TESTS",
        "SMTP_FROM",
        "SMTP_URL"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "env": [
        "DATABASE_URL",
        "INTERNAL_AUTH_SECRET",
        "REDIS_URL",
        "REVENUECAT_API_KEY",
        "RUN_DATABASE_TESTS",
        "RUN_REDIS_TESTS",
        "SMTP_FROM",
        "SMTP_URL"
      ],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    }
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.test"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "env": [
        "DATABASE_URL",
        "INTERNAL_AUTH_SECRET",
        "REDIS_URL",
        "RUN_DATABASE_TESTS",
        "RUN_REDIS_TESTS",
        "SMTP_FROM",
        "SMTP_URL"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "env": [
        "DATABASE_URL",
        "INTERNAL_AUTH_SECRET",
        "REDIS_URL",
        "RUN_DATABASE_TESTS",
        "RUN_REDIS_TESTS",
        "SMTP_FROM",
        "SMTP_URL"
      ],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    }
  }
}

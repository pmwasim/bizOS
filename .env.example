# Local development only. Production values belong in the deployment secret store.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001

DATABASE_URL=postgresql://bizo:bizo_local_only@localhost:5432/bizo
# Generate a unique local value with: openssl rand -hex 32
REDIS_PASSWORD=replace-with-a-generated-local-password
REDIS_URL=redis://:replace-with-a-generated-local-password@localhost:6379

# Cloudflare R2. The example values are intentionally unusable.
R2_ACCOUNT_ID=replace-with-account-id
R2_ACCESS_KEY_ID=replace-with-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-secret-access-key
R2_BUCKET=bizo-local
# Optional override; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com

# Generate at least 32 random bytes for real environments.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_URL=http://localhost:3000
INTERNAL_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
API_INTERNAL_URL=http://localhost:3001/api/v1
# BIZ-003: signs the forwarded client IP so the API only trusts BFF-observed IPs.
# Required in production. Generate with: openssl rand -hex 32. Optional locally.
# CLIENT_IP_SIGNATURE_SECRET=replace-with-a-third-random-secret-of-at-least-32-bytes

# Local messages appear at http://localhost:8025. Production uses a trusted SMTP provider.
SMTP_URL=smtp://localhost:1025
SMTP_FROM=quotes@bizo.local

# Optional n8n automations (local qloudihub stack at http://127.0.0.1:5678).
# bizOS works without these — unset means no webhook calls.
# N8N_CUSTOMIZATION_WEBHOOK_URL=http://127.0.0.1:5678/webhook/bizos/customization-request
# N8N_CI_WEBHOOK_URL=http://127.0.0.1:5678/webhook/bizos/ci-failure
# N8N_WEBHOOK_SECRET=replace-with-shared-hmac-secret-also-set-as-BIZOS_WEBHOOK_SECRET-in-n8n
